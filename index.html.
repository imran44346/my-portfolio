<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const canvas = document.querySelector('#universe');
const renderer = new THREE.WebGLRenderer({
  canvas, antialias: true, alpha: false,
  powerPreference: 'high-performance'
});
renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
renderer.setSize(innerWidth, innerHeight);
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x010102);
const camera = new THREE.PerspectiveCamera(44, innerWidth / innerHeight, .1, 180);
camera.position.set(0, 0, 10.7);

const world = new THREE.Group();
scene.add(world);

const hole = new THREE.Group();
world.add(hole);

// The event horizon: nearly pure black, with a subtle reflective edge.
const horizon = new THREE.Mesh(
  new THREE.SphereGeometry(1.12, 96, 64),
  new THREE.MeshStandardMaterial({
    color: 0x010101, roughness: .25, metalness: .35
  })
);
hole.add(horizon);

const rim = new THREE.Mesh(
  new THREE.TorusGeometry(1.17, .026, 16, 200),
  new THREE.MeshBasicMaterial({
    color: 0xc6cbd4, transparent: true, opacity: .75
  })
);
rim.rotation.x = Math.PI / 2;
hole.add(rim);

// Procedural grayscale accretion disk.
const vertexShader = `
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const fragmentShader = `
  uniform float uTime;
  varying vec2 vUv;

  float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453);
  }

  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(
      mix(hash(i),hash(i+vec2(1.0,0.0)),f.x),
      mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),f.x),
      f.y
    );
  }

  float fbm(vec2 p) {
    float v=0.0;
    float a=.5;
    for(int i=0;i<5;i++) {
      v += noise(p)*a;
      p *= 2.02;
      a *= .5;
    }
    return v;
  }

  void main() {
    vec2 p = vUv - .5;
    float r = length(p)*2.0;
    float a = atan(p.y,p.x);
    float swirl = a + 1.45/(r+.15) - uTime*.20;
    float turbulence = fbm(vec2(a*2.5 + uTime*.06, r*15.0-uTime*.1));
    float bands = .5 + .5*sin(swirl*8.0 + turbulence*5.0);
    float inner = exp(-pow((r-.35)*8.0,2.0));
    float outer = smoothstep(.18,.34,r)*(1.0-smoothstep(.76,1.0,r));
    float streak = pow(max(bands,0.0),3.0);
    float light = (.12 + .42*streak + .34*turbulence + .34*inner)*outer;
    light *= .72 + .28*sin(a*1.8+1.0);
    vec3 charcoal = vec3(.16,.17,.19);
    vec3 silver = vec3(.76,.78,.82);
    vec3 color = mix(charcoal,silver,clamp(light*1.5,0.0,1.0))*light*1.65;
    float alpha = outer*(.15 + .76*clamp(light*1.5,0.0,1.0));
    gl_FragColor = vec4(color,alpha);
    #include <tonemapping_fragment>
    #include <colorspace_fragment>
  }
`;

const diskMaterial = new THREE.ShaderMaterial({
  uniforms: { uTime: { value: 0 } },
  vertexShader, fragmentShader,
  transparent: true,
  depthWrite: false,
  side: THREE.DoubleSide,
  blending: THREE.AdditiveBlending
});

const disk = new THREE.Mesh(new THREE.PlaneGeometry(5.6,5.6), diskMaterial);
disk.rotation.x = -Math.PI / 2.12;
disk.rotation.z = -.14;
hole.add(disk);

// Multiple rings add depth and the illusion of light wrapping around the hole.
[
  { r:1.32, tube:.018, opacity:.48 },
  { r:1.56, tube:.012, opacity:.22 },
  { r:1.86, tube:.010, opacity:.13 },
  { r:2.16, tube:.008, opacity:.08 }
].forEach(item => {
  const ring = new THREE.Mesh(
    new THREE.TorusGeometry(item.r,item.tube,8,200),
    new THREE.MeshBasicMaterial({
      color:0xc3c7d0, transparent:true,
      opacity:item.opacity, blending:THREE.AdditiveBlending,
      depthWrite:false
    })
  );
  ring.rotation.x = Math.PI / 2.12;
  ring.rotation.z = -.14;
  hole.add(ring);
});

// Stars distributed throughout the deep background.
const starCount = 2400;
const positions = new Float32Array(starCount*3);
for (let i=0;i<starCount;i++) {
  const radius=18+Math.random()*75;
  const theta=Math.random()*Math.PI*2;
  const u=Math.random()*2-1;
  const s=Math.sqrt(1-u*u);
  positions[i*3]=radius*s*Math.cos(theta);
  positions[i*3+1]=radius*u;
  positions[i*3+2]=radius*s*Math.sin(theta)-20;
}
const starGeometry = new THREE.BufferGeometry();
starGeometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
const stars = new THREE.Points(
  starGeometry,
  new THREE.PointsMaterial({
    color:0xc5c8d0, size:.045,
    transparent:true, opacity:.75,
    sizeAttenuation:true, depthWrite:false
  })
);
scene.add(stars);

// Orbiting particles.
const particleCount = 850;
const particleData = [];
const particlePositions = new Float32Array(particleCount*3);
for(let i=0;i<particleCount;i++){
  const radius=1.55+Math.random()*2.35;
  const angle=Math.random()*Math.PI*2;
  const y=(Math.random()-.5)*.18;
  particleData.push({radius,angle,y,speed:(.12+Math.random()*.22)*(Math.random()<.5?-1:1)});
  particlePositions[i*3]=Math.cos(angle)*radius;
  particlePositions[i*3+1]=y;
  particlePositions[i*3+2]=Math.sin(angle)*radius;
}
const particleGeometry=new THREE.BufferGeometry();
particleGeometry.setAttribute('position',new THREE.BufferAttribute(particlePositions,3));
const particles=new THREE.Points(
  particleGeometry,
  new THREE.PointsMaterial({
    color:0xd8dbe2,size:.018,
    transparent:true,opacity:.62,
    blending:THREE.AdditiveBlending,depthWrite:false
  })
);
particles.rotation.x=Math.PI/2.12;
hole.add(particles);

// User scroll and joystick controls.
let scrollTarget=0, scrollValue=0;
let mouseX=0, mouseY=0, smoothX=0, smoothY=0;
let joyX=0, joyY=0, targetJoyX=0, targetJoyY=0;

const progress=document.querySelector('#progress');
function updateScroll(){
  const max=document.documentElement.scrollHeight-innerHeight;
  scrollTarget=max>0?scrollY/max:0;
  progress.style.width=(scrollTarget*100)+'%';
}
addEventListener('scroll',updateScroll,{passive:true});
updateScroll();

addEventListener('pointermove',e=>{
  mouseX=(e.clientX/innerWidth-.5)*.35;
  mouseY=(e.clientY/innerHeight-.5)*.24;
},{passive:true});

const joystick=document.querySelector('#joystick');
const stick=document.querySelector('#stick');
let dragging=false;
function setJoystick(e){
  const rect=joystick.getBoundingClientRect();
  const dx=e.clientX-(rect.left+rect.width/2);
  const dy=e.clientY-(rect.top+rect.height/2);
  const limit=27;
  const length=Math.hypot(dx,dy)||1;
  const x=dx/Math.max(1,length)*Math.min(limit,length);
  const y=dy/Math.max(1,length)*Math.min(limit,length);
  stick.style.transform=`translate(calc(-50% + ${x}px),calc(-50% + ${y}px))`;
  targetJoyX=x/limit;
  targetJoyY=y/limit;
}
joystick.addEventListener('pointerdown',e=>{
  dragging=true;
  joystick.setPointerCapture(e.pointerId);
  setJoystick(e);
});
joystick.addEventListener('pointermove',e=>{if(dragging)setJoystick(e);});
function releaseJoystick(){
  dragging=false;
  targetJoyX=0;
  targetJoyY=0;
  stick.style.transform='translate(-50%,-50%)';
}
joystick.addEventListener('pointerup',releaseJoystick);
joystick.addEventListener('pointercancel',releaseJoystick);
document.querySelector('#reset').addEventListener('click',()=>{
  window.scrollTo({top:0,behavior:'smooth'});
  targetJoyX=targetJoyY=0;
  releaseJoystick();
});

// Small interaction ripple on click/tap, except on links and controls.
addEventListener('pointerdown',e=>{
  if(e.target.closest('a,button,#joystick'))return;
  const ripple=document.createElement('div');
  ripple.className='ripple';
  ripple.style.left=e.clientX+'px';
  ripple.style.top=e.clientY+'px';
  document.body.appendChild(ripple);
  setTimeout(()=>ripple.remove(),800);
});

const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  const t=clock.getElapsedTime();

  scrollValue+=(scrollTarget-scrollValue)*.045;
  smoothX+=(mouseX-smoothX)*.035;
  smoothY+=(mouseY-smoothY)*.035;
  joyX+=(targetJoyX-joyX)*.08;
  joyY+=(targetJoyY-joyY)*.08;

  diskMaterial.uniforms.uTime.value=t;

  hole.rotation.y=t*.025+smoothX+joyX*.4+scrollValue*.9;
  hole.rotation.x=-.14+smoothY+joyY*.24+scrollValue*.25;
  hole.rotation.z=-.1+scrollValue*.22+Math.sin(t*.09)*.015;
  const scale=1+scrollValue*.13+Math.sin(t*.2)*.009;
  hole.scale.setScalar(scale);

  // As the user scrolls, the entire 3D scene drifts through the viewport.
  world.position.y=-scrollValue*1.65+Math.sin(scrollValue*Math.PI*2)*.22+joyY*.22;
  world.position.x=Math.sin(scrollValue*Math.PI*1.5)*.25+joyX*.3;
  world.rotation.z=scrollValue*.10+joyX*.025;

  camera.position.z=10.7-scrollValue*.8;
  camera.position.x=smoothX*.8+joyX*.22;
  camera.position.y=.12+scrollValue*.32-smoothY*.5-joyY*.22;
  camera.lookAt(world.position.x*.12,world.position.y*.12,0);

  stars.rotation.y=t*.0015+scrollValue*.10+joyX*.01;
  stars.rotation.x=scrollValue*.035+joyY*.015;

  const arr=particleGeometry.attributes.position.array;
  for(let i=0;i<particleCount;i++){
    const p=particleData[i];
    const a=p.angle+t*p.speed*.14;
    arr[i*3]=Math.cos(a)*p.radius;
    arr[i*3+1]=p.y+Math.sin(a*2+t*.2)*.025;
    arr[i*3+2]=Math.sin(a)*p.radius;
  }
  particleGeometry.attributes.position.needsUpdate=true;

  renderer.render(scene,camera);
}
animate();

function resize(){
  camera.aspect=innerWidth/innerHeight;
  camera.fov=innerWidth<650?52:44;
  camera.updateProjectionMatrix();
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,1.6));
  renderer.setSize(innerWidth,innerHeight);
}
addEventListener('resize',resize);
</script>
</body>
</html>
